# ---------- YouTube (will_provide.py se aata hai)
YT_CLIENT_ID=xxx.apps.googleusercontent.com
YT_CLIENT_SECRET=GOCSPX-xxx
YT_REFRESH_TOKEN=1//xxx
YT_CHANNEL_ID=UCxxx

# rule: subscriber notification OFF
NOTIFY_SUBSCRIBERS=false

# ---------- Playlist (rule: random nahi)
# ek hi playlist sab ke liye:
PLAYLIST_IDS=PLxxxxxxxxxxxxxxxx
# ya category-wise: blog=PLxxx, teaser=PLyyy
PLAYLIST_MAP=

# ---------- Instagram + FB Page
IG_USER_IDS=1784xxxxxxxxxx
IG_ACCESS_TOKEN=EAAX...
FB_PAGE_IDS=xxxxxxxxxxxx

# trial reels: 200+ followers ke baad khud chalu ho jaayega
TRIAL_MIN_FOLLOWERS=200
TRIAL_RATIO=0.4
TRIAL_GRADUATION=SS_PERFORMANCE
TRIAL_DAILY_CAP=10

# ---------- Drive (service account; folder ko that email pe share karo)
GOOGLE_SERVICE_ACCOUNT_JSON=./sa.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
FOLDER_REENCODED=

# ---------- misc
IG_REENCODE=1
IG_DAILY_LIMIT=100
